# MOZa Weekly Mattermost-input — environment variables
# Kopieer naar .env (in repo-root) en vul in. .env is gitignored.
#
# Twee patterns voor token:
#
#   (A) 1Password CLI:
#       MATTERMOST_TOKEN=op://Private/MOZa Mattermost/token
#       Aanroep: op run --env-file=.env -- just moza-weekly
#
#   (B) Directe waarde:
#       MATTERMOST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#       Aanroep: just moza-weekly
#
# Personal access token aanmaken via Mattermost-UI:
#   Account Settings > Security > Personal Access Tokens > Create New Token

MATTERMOST_TOKEN=

# Optioneel — defaults staan rechts van het =
MOZA_WEEKLY_SERVER_URL=https://digilab.overheid.nl/chat
MOZA_WEEKLY_TEAM=mijnoverheid-zakelijk
MOZA_WEEKLY_CHANNELS=check-in,agenda,sprint-faq

# Optioneel: cookie 'docs_sessionid' uit je browser, om verslagen uit Docs te
# halen. Zie scripts/moza-weekly/README.md.
DOCS_SESSION=
MOZA_WEEKLY_DOCS_URL=https://docs.rijksapp.nl
